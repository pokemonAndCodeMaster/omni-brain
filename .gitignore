# ── 派生索引产物（可从知识文件完整重建） ──
.derived/

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/

# ── Conda ──
# conda 环境不提交，用 environment.yml 重建

# ── Node / 前端 ──
node_modules/
.npm/
dist/
.nuxt/
.next/
.output/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── 临时和运行时 ──
*.log
*.tmp
*.bak
.env
.env.local
.env.*.local

# ── 敏感配置 ──
config/secrets.yaml

# ── Omni-Brain 特定忽略 ──
workspaces/task-cases/*
!workspaces/task-cases/.keep
knowledge/raw/conversations/*
!knowledge/raw/conversations/.keep

# ── 遗留环境与本地工具配置 ──
.bash*
.zsh*
.profile
.gitconfig
.mcp.json
.ripgreprc
.codex-log-backups/
.claude/
.codex/
