{
  "name": "quality-check-frontend-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "type-check": "vue-tsc -b",
    "build": "npm run type-check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@tanstack/vue-table": "8.21.3",
    "@tanstack/vue-virtual": "3.13.32",
    "axios": "1.18.1",
    "echarts": "6.1.0",
    "gridstack": "12.6.0",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vue-tsc": "3.1.3",
    "@tsconfig/node22": "22.0.5",
    "@vue/tsconfig": "0.9.1"
  }
}
