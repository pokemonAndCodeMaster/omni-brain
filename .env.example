# 可选覆盖。默认使用项目内 Unix socket，不监听 TCP，也不需要密码。
QC_DB_HOST=.runtime/postgres/socket
QC_DB_PORT=55432
QC_DB_NAME=quality_lab
QC_DB_USER=quality_lab
QC_DB_SCHEMA=manual_qc_lab
QC_LOG_LEVEL=INFO
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Agent Runtime：Codex/OpenCode 双执行器。相对路径以本仓库根目录解析。
OMNI_AGENT_REGISTRY=../omni-brain/config/agent-registry.yaml
OMNI_RUN_ROOT=../.omni-brain-runs
OMNI_RUN_ARTIFACT_ROOT=.runtime/agent-runs
CODEX_COMMAND=codex
OPENCODE_COMMAND=opencode
# 已有 OpenCode server 时填写；留空则每次 Run 使用本机随机端口。
OPENCODE_ENDPOINT=
